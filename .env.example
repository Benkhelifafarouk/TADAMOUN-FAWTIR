# ---------------------------------------------------------------------------
# TADAMOUN FAWTIR — environment template. Copy to `.env.local` for development.
# NEVER commit a filled .env file. Every value below is a placeholder.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Public origin of the app (no trailing slash). Used for cookies, links, receipts.
APP_URL=http://localhost:3000

# 32+ random bytes, base64 or hex. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Required in production. In development a deterministic warning value is used.
APP_SECRET=

# Secret used to sign short-lived private file URLs (separate from APP_SECRET).
FILE_SIGNING_SECRET=

# Shared secret for the internal job-tick endpoint (cron / worker).
JOBS_TICK_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# pglite  -> embedded PostgreSQL (WASM) stored on disk. Zero external services.
# postgres -> any PostgreSQL 15+ server, including Supabase.
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite

# Used when DATABASE_DRIVER=postgres. Supabase: Project Settings -> Database.
# Prefer the pooled connection string for the app and a direct one for migrations.
DATABASE_URL=
DATABASE_SSL=true

# Run pending migrations automatically on first database access (dev/demo only).
AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Feature flags — real money is OFF by default by design.
# ---------------------------------------------------------------------------
# Payment provider: demo | none  (real providers are not implemented/contracted)
PAYMENT_PROVIDER=demo
# Must remain false until a licensed PSP agreement and legal review exist.
PAYMENTS_LIVE_ENABLED=false
# Public donation flow requires the legal checklist to be signed off.
PUBLIC_DONATIONS_ENABLED=true
# Enable demo seed data (synthetic only).
DEMO_MODE=true

# ---------------------------------------------------------------------------
# OCR / AI (provider independent)
# ---------------------------------------------------------------------------
# demo      -> real text extraction for PDFs, clearly-labelled simulation for images
# http      -> POST to OCR_PROVIDER_URL (must speak the documented contract)
OCR_PROVIDER=demo
OCR_PROVIDER_URL=
OCR_PROVIDER_API_KEY=
OCR_PROVIDER_MODEL=
# External AI processing is off unless explicitly enabled after a privacy review.
EXTERNAL_AI_PROCESSING_ENABLED=false

# ---------------------------------------------------------------------------
# Notifications (no provider configured = nothing is ever reported as sent)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_URL=
SMS_PROVIDER=none
SMS_API_KEY=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/private-storage

# ---------------------------------------------------------------------------
# Security tuning
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
RATE_LIMIT_MAX=20
